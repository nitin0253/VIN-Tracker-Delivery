# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — your password must NEVER be committed.
# On Vercel, set these same keys under Project → Settings → Environment Variables.

METABASE_URL=https://metabase.spyne.ai

# Your Metabase login (the account you sign in with in the browser):
METABASE_USER=you@spyne.ai
METABASE_PASSWORD=your-metabase-password

# The private "VIN tracker" question ids (from metabase.spyne.ai/question/<ID>-...).
# The dashboard merges both versions; defaults are baked in, so override only if the
# question ids change. (Legacy VIN_CARD_ID still works as the v2 id.)
VIN_CARD_ID_V2=12497
VIN_CARD_ID_V1=12832
VIN_CARD_ID_V1_IM=12947

# --- Optional ---
# Use an admin-issued API key INSTEAD of user/password (leave blank to use login):
# METABASE_API_KEY=
# Override the enterprise public link if it ever changes:
# ENT_URL=https://metabase.spyne.ai/public/question/b8f1271c-cc5a-470f-badf-807711f74af4.csv
